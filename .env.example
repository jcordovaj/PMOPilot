# ==========================================
# PMOPilot: Configuración de Variables de Entorno
# ==========================================

# Orquestación Cognitiva con Gemini (google-genai SDK)
GEMINI_API_KEY="your-gemini-api-key-here"

# Gateway de Correo Transaccional (SendGrid API / SMTP Relay)
SENDGRID_API_KEY="SG.your_sendgrid_key_here"
SENDGRID_SENDER_EMAIL="no-reply@pmopilot.com"

# Gobernanza Perimetral y Seguridad CDN (Cloudflare API v4)
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Persistencia Nativa NoSQL en AWS (DynamoDB)
# Localhost DynamoDB: http://localhost:8000
# AWS Cloud: Vacío para resolver dinámicamente vía AWS IAM Role
DYNAMODB_ENDPOINT="http://localhost:8000"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="fakeAccessKeyId"
AWS_SECRET_ACCESS_KEY="fakeSecretAccessKey"
DYNAMODB_TABLE_PREFIX="pmopilot-dev-"

# Sincronización Git & Integración Continua (CI/CD)
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_WEBHOOK_SECRET="your_webhook_signature_secret_here"

# Servidor Híbrido & Entorno Node.js
PORT=3000
NODE_ENV="development"
